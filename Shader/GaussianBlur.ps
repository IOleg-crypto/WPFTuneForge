sampler2D input : register(s0);

float Radius : register(c0); тя
float2 PixelSize : register(c1); 

float4 main(float2 uv : TEXCOORD) : COLOR
{
    float4 color = float4(0,0,0,0);
    float total = 0;

    int r = int(Radius);
    for(int x = -r; x <= r; x++)
    {
        for(int y = -r; y <= r; y++)
        {
            float weight = exp(-((x*x + y*y) / (2 * Radius * Radius)));
            color += tex2D(input, uv + float2(x,y) * PixelSize) * weight;
            total += weight;
        }
    }
    return color / total;
}

technique Blur
{
    pass P0
    {
        PixelShader = compile ps_3_0 main();
    }
}
