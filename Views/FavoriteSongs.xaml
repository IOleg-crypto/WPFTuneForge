<Page  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:WpfTuneForgePlayer.Views"
    x:Class="WpfTuneForgePlayer.Views.FavoriteSongs"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    Background="#FF0A0A0A"
    Title="FavoriteSongs"
    xmlns:ViewModel="clr-namespace:WpfTuneForgePlayer.ViewModel"
    d:DataContext="{d:DesignInstance Type=ViewModel:MusicViewModel}">

    <Page.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Click="BackToMainPage" Width="35" Height="34" Margin="50,5,25,0" 
                Foreground="Transparent" BorderBrush="Transparent" Background="Transparent"  
                HorizontalAlignment="Right" Panel.ZIndex="999" VerticalAlignment="Top">
            <Image Source="pack://siteoforigin:,,,/assets/sidebar/exit.png"
                   Stretch="Uniform"
                   Width="32"
                   Height="34"/>
        </Button>

        <TextBlock Grid.Row="0"
                   Text="🎵 Favorite Songs"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="Gold"
                   Margin="0,0,0,20"
                   TextOptions.TextRenderingMode="ClearType">
            <TextBlock.Effect>
                <DropShadowEffect Color="White" BlurRadius="15" ShadowDepth="5" Opacity="0.6"/>
            </TextBlock.Effect>
        </TextBlock>

        <Button Style="{StaticResource SaveButtonStyle}" Command="{Binding Commands.SaveFavoriteSongs}" Height="30"  
        HorizontalContentAlignment="Center"
        VerticalAlignment="Top" 
        Margin="375,10,107,0"
        Content="Save current favorite songs"></Button>

        <Border Grid.Row="1"
        Background="#22FFFFFF" 
        CornerRadius="10"
        Padding="15"
        Margin="0,0,0,0">
            <DataGrid x:Name="FavoriteSongsGrid"
                      MaxHeight="400" 
              AutoGenerateColumns="False"
              CanUserAddRows="True"
              HeadersVisibility="Column"
              RowBackground="#22000000"
              AlternatingRowBackground="#33000000"
              Foreground="White"
              GridLinesVisibility="Horizontal"
              Background="Transparent"
              CanUserSortColumns ="True"
              CanUserDeleteRows ="True"
              IsEnabled="True"
                      
              IsReadOnly="False"
              BorderThickness="0"
              FontSize="16"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              VerticalScrollBarVisibility="Visible"
              ItemsSource="{Binding FavoriteSongs}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="👤 Artist" Binding="{Binding Artist}" IsReadOnly="True"  Width="2*" />
                    <DataGridTextColumn Header="🎧 Title" Binding="{Binding Title}" IsReadOnly="True" Width="2*" />
                    <DataGridTextColumn Header="⏱ Duration" Binding="{Binding Duration}" IsReadOnly="True" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel>
            <Label Content="* You can add or remove songs by editing the grid above. Changes will be saved when you click 'Save current favorite songs'." 
                   Foreground="LightGray" 
                   FontSize="12" 
                   Margin="0,5,0,0"
                   HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>